BOT_TOKEN=123456789:replace_me
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
ARCHIVE_CHAT_ID=-1001234567890
PUBLIC_HOST=files.example.com
PUBLIC_BASE_URL=https://files.example.com
BOT_USERNAME=your_file_link_bot
DATABASE_PATH=/app/data/files.sqlite3
BOT_API_DATA_DIR=/var/lib/telegram-bot-api
MAX_FILE_BYTES=4294967296
CACHE_TTL_HOURS=24
CACHE_CONCURRENCY=1
PORT=8080
# Optional comma-separated Telegram user IDs. Empty means anyone can use the bot.
ALLOWED_TELEGRAM_USER_IDS=
