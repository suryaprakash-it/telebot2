# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_API_ID=your-api-id-from-my-telegram-org
TELEGRAM_API_HASH=your-api-hash-from-my-telegram-org
ARCHIVE_CHAT_ID=-1001234567890
PUBLIC_BASE_URL=https://files.yourdomain.com
BOT_USERNAME=YourBotUsername

# ── Access control (optional) ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs. Leave empty to allow any user.
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# ── File limits (optional) ────────────────────────────────────────────────────
# MAX_FILE_BYTES=4294967296

# ── Cache settings (optional) ─────────────────────────────────────────────────
# CACHE_TTL_HOURS=24
# CACHE_CONCURRENCY=1

# ── Streaming performance (optional) ──────────────────────────────────────────
# Maximum concurrent browser range streams.
# STREAM_CONCURRENCY=3
# Maximum concurrent public file transfers (excess requests receive 503 + Retry-After).
# DOWNLOAD_CONCURRENCY=10
# Maximum parallel HTTP ranges admitted for one file link (excess receive 429 + Retry-After).
# PER_FILE_DOWNLOAD_CONCURRENCY=5
# Pipelined 512 KiB Telegram requests per browser range stream.
# STREAM_PIPELINE_CHUNKS=4
# Shared cap on total in-flight Telegram file requests across all streams.
# STREAM_REQUEST_CONCURRENCY=8

# ── Retry configuration (optional) ────────────────────────────────────────────
# Maximum retries per chunk batch on transient Telegram errors.
# MAX_RETRIES=3
# Base delay in seconds for exponential backoff (doubles each attempt, max 10s).
# RETRY_BASE_DELAY=0.5

# ── Paths (optional) ─────────────────────────────────────────────────────────
# DATABASE_PATH=/app/data/files.sqlite3
# BOT_API_DATA_DIR=/var/lib/telegram-bot-api
# TELETHON_SESSION_PATH=/app/data/telegram-stream

# ── Network (optional) ────────────────────────────────────────────────────────
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
# PORT=8080

# ── Docker Compose / Caddy (optional) ─────────────────────────────────────────
# PUBLIC_HOST=files.yourdomain.com

# ── Logging (optional) ────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
